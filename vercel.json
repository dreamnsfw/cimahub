{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{public/**,db/**}"
    }
  },
  "routes": [
    {
      "src": "^/(app\\.js|navigation\\.js|title-markup\\.js|home-carousel\\.js|media-links\\.js|media-images\\.js|filter-controls\\.js|pagination\\.js|styles\\.css|favicon\\.svg|fonts/DroidKufi-Regular\\.ttf)$",
      "methods": ["GET", "HEAD"],
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Vercel-CDN-Cache-Control": "public, max-age=31536000",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://image.tmdb.org data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://megamax.me; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
      }
    },
    {"src": "/(.*)", "dest": "/api/index.mjs"}
  ]
}
